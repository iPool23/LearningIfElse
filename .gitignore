# ================================================
#  LearningIfElse v1 — Senior .gitignore
# ================================================

# ---- Carpetas temporales y caché de Unity ----
[Ll]ibrary/
[Tt]emp/
[Oo]bj/
[Bb]uild/
[Bb]uilds/
[Ll]logs/
[Mm]emoryCaptures/
/[Uu]ser[Ss]ettings/

# ---- Archivos del IDE / Soluciones ----
.vs/
.vscode/
*.csproj
*.unityproj
*.sln
*.user
*.userprefs
*.pdb
*.opendb

# ---- Regla Global de Assets (Solo subir nuestro trabajo) ----
# Ignoramos todo el contenido de Assets por defecto
/Assets/*

# EXCEPCIONES: Lo que SÍ queremos en el repositorio
!/Assets/_Core/
!/Assets/_Barking_Dog/
!/Assets/InputSystem_Actions.inputactions
!/Assets/InputSystem_Actions.inputactions.meta

# ---- Project Configuration ----
!/ProjectSettings/
!/Packages/
!/README.md
!/skills.sh
!/.gitignore

# ---- Git LFS for Binaries (Opcional si se usa LFS) ----
*.mp3
*.wav
*.png
*.jpg
*.fbx
*.mat
*.unity
